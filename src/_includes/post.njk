{% extends "base.njk" %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "{{ title }}",
  "description": "{{ description }}",
  "author": {"@type": "Organization", "name": "Viex Salud"},
  "publisher": {"@type": "Organization", "name": "Viex Salud", "logo": {"@type": "ImageObject", "url": "https://www.viexsalud.cl/assets/img/logo-mark.svg"}},
  "mainEntityOfPage": "{{ canonical }}",
  "datePublished": "{{ page.date | isoDate }}",
  "dateModified": "{% if updated %}{{ updated | isoDate }}{% else %}{{ page.date | isoDate }}{% endif %}",
  "inLanguage": "es-CL"
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://www.viexsalud.cl/"},
    {"@type": "ListItem", "position": 2, "name": "Blog", "item": "https://www.viexsalud.cl/blog/"},
    {"@type": "ListItem", "position": 3, "name": "{{ title }}", "item": "{{ canonical }}"}
  ]
}
</script>
{% if cover %}
<meta property="og:image" content="https://www.viexsalud.cl{{ cover }}">
<meta property="og:image:alt" content="{{ coverAlt | default(title) }}">
{% endif %}
{% endblock %}

{% block content %}
<section class="article-hero">
  <div class="container">
    <nav class="breadcrumbs" aria-label="Ruta de navegación" style="color:rgba(255,255,255,0.6);">
      <a href="/" style="color:rgba(255,255,255,0.6);">Inicio</a> / <a href="/blog/" style="color:rgba(255,255,255,0.6);">Blog</a> / <span>{{ title }}</span>
    </nav>
    <p class="tag">{{ tag }}</p>
    <h1>{{ title }}</h1>
    <div class="article-meta">
      <span>Por el equipo de Viex Salud</span><span>·</span><span>{{ page.date | readableDate }}</span>{% if updated %}<span>·</span><span>Actualizado {{ updated | readableDate }}</span>{% endif %}<span>·</span><span>{{ content | readingTime }}</span>
    </div>
  </div>
</section>

{% if cover %}
<div class="article-cover"><img src="{{ cover }}" alt="{{ coverAlt | default(title) }}"></div>
{% endif %}

<article class="article-body">
{{ content | safe }}

  {% if sources and sources.length %}
  <aside class="article-sources" aria-labelledby="sources-title">
    <h2 id="sources-title">Fuentes verificadas</h2>
    <ol>
      {% for source in sources %}
      <li>
        <a href="{{ source.url }}" target="_blank" rel="noopener noreferrer">{{ source.title }}</a>
        <span>{{ source.name }}{% if source.published %} · Publicada {{ source.published | readableDate }}{% endif %}{% if source.effective %} · Vigente desde {{ source.effective | readableDate }}{% endif %}</span>
      </li>
      {% endfor %}
    </ol>
  </aside>
  {% endif %}

  <p class="editorial-note"><strong>Compromiso Viex Salud:</strong> informamos, educamos y acompañamos de manera independiente. Este contenido es informativo y no reemplaza la revisión individual del contrato, antecedentes de salud y condiciones de cada Isapre.</p>

  <div class="article-cta">
    <img class="article-cta-logo" src="/assets/img/logo-mark.svg" alt="" width="54" height="54">
    <h3>{{ ctaTitle | default("¿Tienes dudas sobre tu plan actual?") }}</h3>
    <p>{{ ctaText | default("En Viex Salud te ayudamos gratis, sin compromiso.") }}</p>
    <a href="https://wa.me/56948627767" target="_blank" rel="noopener" class="btn btn-primary">Escríbenos por WhatsApp →</a>
  </div>

  <div class="blog-subscribe">
    <h3>Recibe más guías como esta</h3>
    <p>Te avisamos por correo cuando publiquemos algo nuevo sobre Isapres. Sin spam.</p>
    <form id="subscribe-form">
      <input type="email" id="subscribe-email" placeholder="tucorreo@ejemplo.com" required>
      <button type="submit" class="btn btn-primary" id="subscribe-btn">Suscribirme</button>
    </form>
    <p class="subscribe-msg" id="subscribe-msg"></p>
  </div>
</article>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.js"></script>
<script>
(function () {
  "use strict";
  var sb = supabase.createClient(
    "https://jniaoqcgpdryqrssntfp.supabase.co",
    "sb_publishable_BCFzQF1HZw8EPsGsdNvXCQ_0ILWpQB6"
  );
  document.getElementById('subscribe-form').addEventListener('submit', function (e) {
    e.preventDefault();
    var btn = document.getElementById('subscribe-btn');
    var msg = document.getElementById('subscribe-msg');
    var email = document.getElementById('subscribe-email').value.trim();
    btn.disabled = true;
    btn.textContent = 'Enviando...';
    sb.from('suscriptores').insert({ email: email, fuente: window.location.pathname }).then(function (res) {
      btn.disabled = false;
      btn.textContent = 'Suscribirme';
      if (res.error && res.error.code !== '23505') {
        msg.textContent = 'No se pudo suscribir, intenta de nuevo.';
        msg.className = 'subscribe-msg error';
        return;
      }
      msg.textContent = '¡Listo! Ya estás suscrito.';
      msg.className = 'subscribe-msg ok';
      document.getElementById('subscribe-form').reset();
    });
  });
})();
</script>

<section class="section-cream" style="padding-top:0;">
  <div class="container">
    <h2 class="section-title" style="font-size:var(--fs-xl); margin-bottom:1.5rem;">Sigue leyendo</h2>
  </div>
  <div class="related-grid">
    {% set related = collections.blog | relatedPosts(page.url) %}
    {% for post in related %}
    <a class="blog-card" href="{{ post.url }}">
      <div class="thumb">{% if post.data.cover %}<img src="{{ post.data.cover }}" alt="{{ post.data.coverAlt | default(post.data.title) }}" loading="lazy">{% endif %}<span class="tag">{{ post.data.tag }}</span></div>
      <div class="body"><h3>{{ post.data.title }}</h3><span class="read-more">Leer →</span></div>
    </a>
    {% endfor %}
  </div>
</section>
{% endblock %}
