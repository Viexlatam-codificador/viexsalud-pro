<!doctype html>
<html lang="es-CL">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}{% if not noBrandSuffix %} | Viex Salud{% endif %}</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="{{ canonical }}">
<meta name="robots" content="index, follow">
<meta property="og:type" content="{{ ogType | default('article') }}">
<meta property="og:site_name" content="Viex Salud">
<meta property="og:title" content="{{ ogTitle | default(title) }}">
<meta property="og:description" content="{{ ogDescription | default(description) }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:locale" content="es_CL">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Ccircle cx='32' cy='32' r='32' fill='%230e2b25'/%3E%3Ctext x='32' y='42' font-family='Georgia,serif' font-size='30' font-weight='900' fill='%23cba63f' text-anchor='middle'%3EV%3C/text%3E%3C/svg%3E">
<link rel="stylesheet" href="/assets/styles.css">
{% block head %}{% endblock %}

<!-- Google Analytics 4 + Meta Pixel (ver /assets/analytics.js) -->
<script src="/assets/analytics.js" defer></script>
</head>
<body>
<noscript><img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=1995302337788179&amp;ev=PageView&amp;noscript=1" alt="" /></noscript>
<a class="skip-link" href="#main">Saltar al contenido</a>

<header class="site-header">
  <nav class="nav container" aria-label="Navegación principal">
    <a href="/" class="brand"><img src="/assets/img/logo-mark.svg" alt="" width="38" height="38" class="logo-mark-img"> Viex Salud</a>
    <ul class="nav-links" id="nav-links">
      <li><a href="/#como-funciona">Cómo funciona</a></li>
      <li><a href="/#isapres">Isapres</a></li>
      <li><a href="/#nosotros">Nosotros</a></li>
      <li><a href="/blog/">Blog</a></li>
      <li><a href="/recursos-ejecutivos/">Recursos para Ejecutivos</a></li>
      <li><a href="/preguntas-isapre/">Preguntas sobre tu Isapre</a></li>
      <li><a href="/#faq">Preguntas frecuentes</a></li>
    </ul>
    <div class="nav-actions">
      <a href="/#cotizar" class="btn btn-primary btn-sm"><span class="nav-cta-text">Cotizar gratis</span><span aria-hidden="true">→</span></a>
      <button class="nav-toggle" id="nav-toggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="nav-links">☰</button>
    </div>
  </nav>
</header>

<main id="main">
{% block content %}{% endblock %}
</main>

<footer class="site-footer">
  <div class="container">
    <div class="footer-bottom" style="border-top:none; padding-top:0;">
      <span>© <span id="year">{{ currentYear }}</span> Viex Salud · Asesoría independiente de Isapres en Chile</span>
      <a href="/">Volver al inicio</a>
    </div>
  </div>
</footer>

<a class="wa-float" href="https://wa.me/56948627767" target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp">💬</a>
<script src="/assets/script.js" defer></script>
</body>
</html>
