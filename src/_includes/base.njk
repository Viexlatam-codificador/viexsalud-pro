<!doctype html>
<html lang="es-CL">
<head>
<!-- Contentsquare -->
<script src="/assets/contentsquare.js" defer></script>
<!-- End Contentsquare -->
<!-- Google Tag Manager -->
<script src="/assets/gtm.js" defer></script>
<!-- End Google Tag Manager -->
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}{% if not noBrandSuffix %} | Viex Salud{% endif %}</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="{{ canonical }}">
<link rel="alternate" hreflang="es-CL" href="{{ canonical }}">
<link rel="alternate" hreflang="x-default" href="{{ canonical }}">
<meta name="geo.region" content="CL">
<meta name="geo.placename" content="Chile">
<meta name="language" content="es-CL">
<meta http-equiv="content-language" content="es-CL">
{% if '/recursos-ejecutivos/' in page.url or '/ejecutivos/' in page.url %}
<meta name="robots" content="noindex, nofollow">
{% else %}
<meta name="robots" content="index, follow">
{% endif %}
<meta property="og:type" content="{{ ogType | default('article') }}">
<meta property="og:site_name" content="Viex Salud">
<meta property="og:title" content="{{ ogTitle | default(title) }}">
<meta property="og:description" content="{{ ogDescription | default(description) }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:locale" content="es_CL">
<meta property="og:image" content="{{ ogImage | default('https://www.viexsalud.cl/assets/img/og-image.png') }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Viex Salud — Asesoría gratuita para comparar Isapres en Chile">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ ogTitle | default(title) }}">
<meta name="twitter:description" content="{{ ogDescription | default(description) }}">
<meta name="twitter:image" content="{{ ogImage | default('https://www.viexsalud.cl/assets/img/og-image.png') }}">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Ccircle cx='32' cy='32' r='32' fill='%230e2b25'/%3E%3Ctext x='32' y='42' font-family='Georgia,serif' font-size='30' font-weight='900' fill='%23cba63f' text-anchor='middle'%3EV%3C/text%3E%3C/svg%3E">
<link rel="stylesheet" href="/assets/styles.css">
<meta name="google-site-verification" content="xltBLOhdPyIfGnQlFitPt8p-bUTm-VycG2AdhTTfWYY" />
{% block head %}{% endblock %}

<!-- Google Analytics 4 + Meta Pixel (ver /assets/analytics.js) -->
<script src="/assets/analytics.js" defer></script>
</head>
<body>
<a class="skip-link" href="#main">Saltar al contenido</a>

<div class="topbar" aria-hidden="true">
  <div class="topbar-track">
    <span>💛 Gracias por visitarnos — te ayudamos a cotizar tu mejor plan de Isapre, 100% gratis</span>
    <span>💛 Gracias por visitarnos — te ayudamos a cotizar tu mejor plan de Isapre, 100% gratis</span>
  </div>
</div>

<header class="site-header">
  <nav class="nav container" aria-label="Navegación principal">
    <a href="/" class="brand"><img src="/assets/img/logo-mark.svg" alt="" width="38" height="38" class="logo-mark-img"> Viex Salud</a>
    <ul class="nav-links" id="nav-links">
      {% include "public-navigation.njk" %}
    </ul>
    <div class="nav-actions">
      <a href="/#cotizar" class="btn btn-primary btn-sm" aria-label="Cotizar gratis"><span class="nav-cta-text">Cotizar gratis</span><span aria-hidden="true">→</span></a>
      <button class="nav-toggle" id="nav-toggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="nav-links">☰</button>
    </div>
  </nav>
</header>

<main id="main">
{% block content %}{% endblock %}
</main>

<footer class="site-footer">
  <div class="container">
    <div class="footer-bottom" style="border-top:none; padding-top:0;">
      <span>© <span id="year">{{ currentYear }}</span> Viex Salud · Asesoría de Isapres en todo Chile</span>
      <a href="/politica-de-privacidad/">Política de Privacidad</a>
      <a href="/">Volver al inicio</a>
    </div>
  </div>
</footer>

<a class="wa-float" href="https://wa.me/56948627767" target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp"><svg viewBox="0 0 24 24" width="28" height="28" fill="none" aria-hidden="true"><path d="M20 11.5a8 8 0 0 1-11.9 7L4 20l1.5-4.1A8 8 0 1 1 20 11.5Z" stroke="currentColor" stroke-width="1.8"/><path d="M9 8c0 3.5 3.5 7 7 7l1-2-2-1-1 1-3-3 1-1-1-2Z" fill="currentColor"/></svg></a>
<script src="/assets/script.js" defer></script>
<!-- Tawk.to Live Chat -->
<script src="/assets/tawk.js" defer></script>
<!-- End Tawk.to Live Chat -->
</body>
</html>
