{% extends "base.njk" %}

{% block content %}
<style>
  .isaprecalc {
    --bg: #eef3f2;
    --surface: #ffffff;
    --surface-alt: #f6faf9;
    --border: #d7e2e0;
    --ink: #16262b;
    --ink-soft: #55676c;
    --ink-faint: #86979b;
    --blue: #1f6f8b;
    --blue-ink: #0f4a5e;
    --blue-soft: #e6f1f5;
    --green: #1c8a5a;
    --green-ink: #0e5a3a;
    --green-soft: #e5f6ec;
    --danger: #b3392a;
    --danger-soft: #fbeae7;
    --focus: #2f8fb0;
    --calc-shadow: 0 1px 2px rgba(20, 40, 45, 0.06), 0 8px 24px -12px rgba(20, 40, 45, 0.18);
    --calc-radius: 14px;
    --mono: ui-monospace, "SF Mono", "Cascadia Mono", Menlo, Consolas, monospace;
    --calc-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  @media (prefers-color-scheme: dark) {
    .isaprecalc {
      --bg: #0d1417;
      --surface: #141d21;
      --surface-alt: #182226;
      --border: #263940;
      --ink: #e7eef0;
      --ink-soft: #9db0b5;
      --ink-faint: #6c8085;
      --blue: #67bcdd;
      --blue-ink: #bfe6f4;
      --blue-soft: #16313c;
      --green: #56d69a;
      --green-ink: #c3f3dd;
      --green-soft: #10321f;
      --danger: #ff7a68;
      --danger-soft: #3a1f1c;
      --calc-shadow: 0 1px 2px rgba(0, 0, 0, 0.3), 0 8px 28px -12px rgba(0, 0, 0, 0.55);
    }
  }

  .isaprecalc, .isaprecalc * { box-sizing: border-box; }
  .isaprecalc {
    background: var(--bg);
    color: var(--ink);
    font-family: var(--calc-sans);
    line-height: 1.45;
    -webkit-font-smoothing: antialiased;
    padding: 32px 0 24px;
  }
  .isaprecalc .wrap {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 20px 40px;
  }
  .isaprecalc a { color: var(--blue); }
  .isaprecalc a.btn { text-decoration: none; display: inline-flex; align-items: center; }

  .isaprecalc header.top {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    margin-bottom: 26px;
  }
  .isaprecalc .mark {
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: linear-gradient(155deg, var(--blue), var(--green));
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--calc-shadow);
  }
  .isaprecalc .mark svg { width: 24px; height: 24px; }
  .isaprecalc header.top h1 {
    font-size: 1.5rem;
    margin: 0 0 2px;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .isaprecalc header.top p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.92rem;
  }

  .isaprecalc .tabs { display: flex; gap: 8px; margin-bottom: 24px; }
  .isaprecalc .tabs a {
    font-size: 0.86rem; font-weight: 700; text-decoration: none; color: var(--ink-soft);
    padding: 7px 15px; border-radius: 999px; border: 1px solid var(--border);
  }
  .isaprecalc .tabs a.active { background: var(--ink); color: var(--surface); border-color: var(--ink); }
  .isaprecalc .tabs a:not(.active):hover { border-color: var(--blue); color: var(--blue); }

  .isaprecalc .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    align-items: start;
  }
  @media (max-width: 860px) {
    .isaprecalc .grid { grid-template-columns: 1fr; }
  }

  .isaprecalc .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--calc-radius);
    box-shadow: var(--calc-shadow);
    overflow: hidden;
  }
  .isaprecalc .card__head {
    padding: 18px 20px 14px;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .isaprecalc .card__head .dot {
    width: 9px; height: 9px; border-radius: 50%; flex: none;
  }
  .isaprecalc .card--novenos .card__head .dot { background: var(--blue); }
  .isaprecalc .card--siete .card__head .dot { background: var(--green); }
